{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Generar WAR",
			"type": "shell",
			"command": "./mvnw",
			"args": [
				"clean",
				"package",
				"-DskipTests"
			],
			"windows": {
				"command": "powershell.exe",
				"args": [
					"-NoProfile",
					"-ExecutionPolicy",
					"Bypass",
					"-File",
					"${workspaceFolder}\\scripts\\generar-war.ps1"
				]
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": [],
			"detail": "Genera target/medical-api.war para desplegar en WebLogic"
		}
	]
}
